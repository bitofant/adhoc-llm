# DeepSeek V4.1 Flash — official weights, unquantized.
# Findings + rationale: docs/models/deepseek-v41-flash.md
# NOTE: values below come from a planning session and are UNVERIFIED. Check
# against AWS + HF before spending money. See docs/providers/aws-g7e.md.

PROVIDER=aws

# --- model ---
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash   # verify exact repo id
WEIGHTS_SIZE_GB=510
QUANTIZATION=none                          # policy: unquantized, see CLAUDE.md

# --- hardware ---
AWS_INSTANCE_TYPE=g7e.24xlarge             # 4x RTX PRO 6000, 384GB VRAM, 1TB RAM, 7.6TB NVMe
AWS_LIFECYCLE=spot                         # fallback: on-demand
AWS_REGION=
AWS_AMI_ID=                                # baked: NVIDIA driver + SGLang image
AWS_S3_BUCKET=                             # weights + kernel cache, encrypted

# --- serving ---
SERVER=sglang
TP_SIZE=4
SPEC_DECODING=dspark
ENGRAM_MODE=nvme                           # nvme = tested; ram = unverified, 1TB RAM allows it
MAX_CONTEXT=400000
BIND_ADDR=127.0.0.1                        # never bind public; reach via tailscale/ssh tunnel
LOG_REQUESTS=false

# --- safety rails ---
IDLE_SHUTDOWN_MIN=30
